using System.Collections.Generic;

namespace BlackJack_TheSpire
{
    // ----------------------------------------------------------------
    // Boss
    // 단일 보스를 나타내는 클래스
    // ----------------------------------------------------------------
    public class Boss
    {
        // 보스 이름 (UI 표시용)
        public string Name { get; private set; }

        // 난이도 별점 1~5
        public int StarRating { get; private set; }

        // 보스 등장 연출 대사
        public string FlavorText { get; private set; }

        // 보스가 가진 효과 3개
        public List<BossEffect> Effects { get; private set; }

        // 현재 이 보스가 활성 상태(라운드 진행 중)인지 여부
        public bool IsActive { get; private set; }

        // ------------------------------------------------------------
        // 생성자 : 보스 기본 정보와 효과 목록을 받아 초기화
        // ------------------------------------------------------------
        public Boss(string name, int star, string flavorText, List<BossEffect> effects)
        {
            Name       = name;
            StarRating = star;
            FlavorText = flavorText;
            Effects    = effects;
            IsActive   = false;
        }

        // ------------------------------------------------------------
        // Activate() : 보스 라운드가 시작될 때 호출 → 활성 상태로 전환
        // BossManager.StartBossRound() 에서 호출한다.
        // ------------------------------------------------------------
        public void Activate()   => IsActive = true;

        // ------------------------------------------------------------
        // Deactivate() : 보스 라운드가 끝날 때 호출 → 비활성 상태로 전환
        // BossManager.EndBossRound() 에서 호출한다.
        // ------------------------------------------------------------
        public void Deactivate() => IsActive = false;

        // ------------------------------------------------------------
        // HasEffect() : 특정 효과 타입이 이 보스에 존재하는지 확인
        // 게임 로직에서 "이 보스가 버스트 전액 몰수 효과를 가졌나?" 처럼 사용
        // ------------------------------------------------------------
        public bool HasEffect(BossEffectType type)
            => Effects.Exists(e => e.EffectType == type);

        // ------------------------------------------------------------
        // GetEffect() : 특정 효과 객체를 반환 (Value 등을 읽을 때 사용)
        // 해당 효과가 없으면 null 반환
        // ------------------------------------------------------------
        public BossEffect GetEffect(BossEffectType type)
            => Effects.Find(e => e.EffectType == type);
    }

    // ----------------------------------------------------------------
    // BossFactory
    // 5명의 보스 인스턴스를 생성하여 리스트로 반환하는 정적 팩토리 클래스
    // 인덱스 0 = 1사이클 보스(빚쟁이 잭) ~ 인덱스 4 = 5사이클 최종 보스(레드 조커)
    // ----------------------------------------------------------------
    public static class BossFactory
    {
        // ------------------------------------------------------------
        // CreateAllBosses()
        // BossManager 초기화 시 1회 호출된다.
        // 반환값 : 사이클 순서대로 정렬된 Boss 리스트 (총 5개)
        // ------------------------------------------------------------
        public static List<Boss> CreateAllBosses()
        {
            var list = new List<Boss>();

            // ── 1사이클 보스 ─────────────────────────────────────────
            // 빚쟁이 잭 (★☆☆☆☆)
            // 배팅 압박과 폴드 제한으로 플레이어를 살짝 압박하는 입문 보스
            list.Add(new Boss(
                name:       "빚쟁이 잭",
                star:       1,
                flavorText: "\"첫 번째 관문. 아직은 봐줄 만하다...\"",
                effects: new List<BossEffect>
                {
                    new BossEffect(
                        BossEffectType.MinBetIncrease,
                        "최소 배팅 인상",
                        "이 라운드의 최소 배팅칩이 기존보다 1.5배 높아진다.",
                        value: 1.5f          // 배율 1.5배
                    ),
                    new BossEffect(
                        BossEffectType.FoldLimitOne,
                        "폴드 제한",
                        "이 라운드에서 폴드 가능 횟수가 1회로 고정된다.",
                        value: 1f            // 최대 폴드 횟수 1회
                    ),
                    new BossEffect(
                        BossEffectType.ShopPriceUp,
                        "상점 세금",
                        "보스 클리어 후 상점의 모든 아이템 가격이 +10칩 비싸진다.",
                        value: 10f           // 가격 인상분 10칩
                    )
                }
            ));

            // ── 2사이클 보스 ─────────────────────────────────────────
            // 눈먼 딜러 (★★☆☆☆)
            // 정보를 차단하고 덱 전략을 흔들어 불확실성을 극대화하는 보스
            list.Add(new Boss(
                name:       "눈먼 딜러",
                star:       2,
                flavorText: "\"그가 테이블에 앉으면, 패가 뒤집힌다.\"",
                effects: new List<BossEffect>
                {
                    new BossEffect(
                        BossEffectType.HideHiddenCard,
                        "히든 카드 봉인",
                        "딜러의 히든 카드를 절대 볼 수 없다. 딜러 정보 아이템 효과가 무효화된다."
                    ),
                    new BossEffect(
                        BossEffectType.ForceDeckShuffle,
                        "덱 강제 셔플",
                        "매 블랙잭 판 시작 전 덱이 강제로 셔플된다. 덱 조작 아이템 효과가 반감된다."
                    ),
                    new BossEffect(
                        BossEffectType.RandomizeMission,
                        "미션 랜덤화",
                        "4판 중 미션이 매 판마다 랜덤으로 바뀐다. 미션 준비가 어려워진다."
                    )
                }
            ));

            // ── 3사이클 보스 ─────────────────────────────────────────
            // 탐욕의 왕 (★★★☆☆)
            // 칩이 많을수록 손해가 커지는 역발상 보스 / 자원 관리의 핵심 분기점
            list.Add(new Boss(
                name:       "탐욕의 왕",
                star:       3,
                flavorText: "\"더 많이 가질수록, 더 많이 잃게 된다.\"",
                effects: new List<BossEffect>
                {
                    new BossEffect(
                        BossEffectType.ChipTaxOnStart,
                        "역이자 저주",
                        "라운드 시작 시 보유 칩의 10%를 강제로 차감한다.",
                        value: 0.10f         // 차감 비율 10%
                    ),
                    new BossEffect(
                        BossEffectType.GreedPenalty,
                        "과욕의 벌",
                        "100칩 이상 배팅 후 이기면 배팅액 중 100칩 초과분의 20%를 추가 징수한다.",
                        value: 0.20f         // 초과분 징수 비율 20%
                    ),
                    new BossEffect(
                        BossEffectType.ShopItemCountOne,
                        "상점 독점",
                        "보스 라운드 클리어 후 상점 아이템이 1개만 진열된다.",
                        value: 1f            // 진열 아이템 수 1개
                    )
                }
            ));

            // ── 4사이클 보스 ─────────────────────────────────────────
            // 심판자 블라인드 (★★★★☆)
            // 플레이어 선택권을 직접 박탈 / 쌓아온 아이템 빌드를 흔드는 후반 위기
            list.Add(new Boss(
                name:       "심판자 블라인드",
                star:       4,
                flavorText: "\"규칙은 내가 정한다. 지금 이 순간만큼은.\"",
                effects: new List<BossEffect>
                {
                    new BossEffect(
                        BossEffectType.BurstFullLoss,
                        "버스트 즉사",
                        "버스트 발생 시 배팅 칩 전액이 몰수된다. 기존의 배팅액만 잃는 규칙이 무효화된다."
                    ),
                    new BossEffect(
                        BossEffectType.ForceHitUnder14,
                        "강제 히트",
                        "핸드 합계가 14 이하일 경우 반드시 히트해야 한다. 스탠드 버튼이 비활성화된다.",
                        value: 14f           // 강제 히트 임계값 14
                    ),
                    new BossEffect(
                        BossEffectType.RandomItemLock,
                        "아이템 봉인",
                        "보유 아이템 중 랜덤 2개가 이 라운드 동안 사용 불가 상태가 된다.",
                        value: 2f            // 봉인 아이템 수 2개
                    )
                }
            ));

            // ── 5사이클 최종 보스 ────────────────────────────────────
            // 레드 조커 (★★★★★)
            // 단 한 번의 실수가 게임을 끝낼 수 있는 최후의 관문
            list.Add(new Boss(
                name:       "파국의 딜러, 레드 조커",
                star:       5,
                flavorText: "\"마지막 테이블엔 자비가 없다. 모든 걸 걸어라.\"",
                effects: new List<BossEffect>
                {
                    new BossEffect(
                        BossEffectType.TwoLossChipPenalty,
                        "최후의 심판",
                        "4판 중 2판 이상 패배 시 보유 칩의 40%가 몰수되고 라운드가 강제 종료된다.",
                        value: 0.40f         // 몰수 비율 40%
                    ),
                    new BossEffect(
                        BossEffectType.CursedCardInsert,
                        "저주받은 덱",
                        "매 판 시작 시 덱에 저주 카드(뽑으면 합계 +10) 1장이 무작위로 삽입된다.",
                        value: 10f           // 저주 카드가 추가하는 점수 +10
                    ),
                    new BossEffect(
                        BossEffectType.ForceAllIn,
                        "올인 강제",
                        "첫 번째 판은 반드시 보유 칩 전액을 배팅해야 한다."
                    )
                }
            ));

            return list;
        }
    }
}
